{
    "name": "internal/php-micro-email",
    "description": "Bulk transactional email microservice",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
